# Optional: accounts, cloud saves and the leaderboard (Supabase).
# Copy to .env.local for local dev, and add both to Vercel → Project → Settings
# → Environment Variables. The anon key is public by design; the tables are
# protected by row-level security (supabase/schema.sql).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
